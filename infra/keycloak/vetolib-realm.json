{
  "realm": "vetolib",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 5,
  "passwordPolicy": "hashAlgorithm(pbkdf2-sha512) and length(8)",
  "roles": {
    "realm": [
      {
        "name": "Admin",
        "description": "Clinic administrator with full access"
      },
      {
        "name": "Vet",
        "description": "Veterinarian with clinical access"
      },
      {
        "name": "Receptionist",
        "description": "Front desk staff with scheduling and billing access"
      },
      {
        "name": "Assistant",
        "description": "Veterinary assistant with limited clinical access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "vetolib-api",
      "name": "Vetolib API",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "**********",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "access.token.lifespan": "300",
        "use.refresh.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "clinic_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "clinic_id",
            "claim.name": "clinic_id",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "vetolib-frontend",
      "name": "Vetolib Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/*",
        "https://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "300",
        "use.refresh.tokens": "true"
      },
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ]
    }
  ],
  "attributes": {
    "organizationsEnabled": "true"
  }
}
