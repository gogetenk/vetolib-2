# .env.example — Vetolib required environment variables
#
# Copy this file to .env and fill in real values before running in production.
# NEVER commit the .env file to source control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with real values
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d

# ── Database ────────────────────────────────────────────────────────────────

# Full PostgreSQL connection string used by the backend in production.
# Format: Host=<host>;Database=<db>;Username=<user>;Password=<password>
DATABASE_URL=

# Password for the Postgres user (used by the postgres service in docker-compose.yml).
# Not required when DATABASE_URL points to an external managed database.
POSTGRES_PASSWORD=change_me_in_production

# ── Authentication ──────────────────────────────────────────────────────────

# Secret key used to sign JWT tokens. Must be at least 32 characters long.
# Generate a secure value with: openssl rand -base64 48
JWT_SECRET=change_me_minimum_32_chars_long_secret_key

# ── CORS ────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins, e.g.:
# CORS_ORIGINS=https://app.vetolib.ae,https://admin.vetolib.ae
CORS_ORIGINS=

# ── Email (optional — defaults to console logger) ───────────────────────────

# Email provider: "console" (dev/default) or "smtp"
EMAIL_PROVIDER=console

# SMTP settings — only required when EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_ADDRESS=noreply@vetolib.ae
SMTP_FROM_NAME=Vetolib

# ── RabbitMQ (optional — falls back to in-memory transport when absent) ─────

# RabbitMQ connection string injected by Aspire or set manually.
# Format: amqp://<user>:<password>@<host>:<port>/
RABBITMQ_URL=

# ── Aspire local development (dotnet run via AppHost) ───────────────────────
#
# When running via Aspire, secrets are NOT read from this .env file.
# Aspire uses dotnet user-secrets on the AppHost project instead.
#
# One-time setup:
#   cd src/backend/AppHost
#   dotnet user-secrets init
#   dotnet user-secrets set "Parameters:jwt-key"     "dev-jwt-secret-min-32-chars"
#   dotnet user-secrets set "Parameters:db-password" "devpassword123"
#
# Aspire resolves Parameters:* from user-secrets in dev, and from environment
# variables in production (names: Parameters__jwt-key / Parameters__db-password).
