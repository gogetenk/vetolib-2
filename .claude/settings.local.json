{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(dotnet:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(echo:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(date:*)",
      "Bash(wc:*)",
      "Bash(gh:*)",
      "Bash(for pr:*)",
      "Bash(export PATH=\"$HOME/scoop/shims:$PATH\")",
      "Bash(code:*)",
      "Bash(where code:*)",
      "Read(//c/Program Files/Microsoft VS Code/bin/**)",
      "Read(//c/Users/Yannis/AppData/Local/Programs/Microsoft VS Code/bin/**)",
      "WebSearch",
      "WebFetch(domain:www.lowcode.agency)",
      "Bash(gh pr:*)",
      "Bash(mv tasks/todo-back-patient-microchip-002.md tasks/done-back-patient-microchip-002.md)",
      "Bash(mv tasks/todo-back-patient-sex-001.md tasks/wip-back-patient-sex-001.md)",
      "Bash(mv tasks/todo-back-patient-species-003.md tasks/wip-back-patient-species-003.md)",
      "Bash(cd:*)",
      "Bash(do echo:*)",
      "Bash(done)",
      "Bash(mv tasks/wip-front-breeding-012.md tasks/done-front-breeding-012.md)",
      "Bash(mv tasks/todo-test-validators-014.md tasks/done-test-validators-014.md)",
      "Bash(mv tasks/todo-perf-critical-fixes-015.md tasks/wip-perf-critical-fixes-015.md)",
      "Bash(mv tasks/todo-security-critical-016.md tasks/done-security-critical-016.md)",
      "Bash(mv tasks/todo-seo-critical-018.md tasks/done-seo-critical-018.md)",
      "mcp__playwright__browser_navigate",
      "Read(//c/Program Files/Google/Chrome/Application/**)",
      "Read(//c/Program Files \\(x86\\)/Microsoft/Edge/Application/**)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(docker:*)",
      "Bash(kubectl:*)",
      "Bash(aws:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/guard-shared.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/verify-before-push.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/log-cost.sh"
          }
        ]
      }
    ]
  },
  "dangerouslySkipPermissions": true
}
