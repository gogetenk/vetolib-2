{
  "Sentry": {
    "Dsn": "",
    "Debug": true
  },
  "ConnectionStrings": {
    "vetolibdb": "Host=localhost;Port=5432;Database=vetolib;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "super-secret-key-for-vetolib-jwt-token-generation-minimum-32-chars"
  },
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/vetolib",
    "Audience": "vetolib-api",
    "ClientId": "vetolib-api",
    "ClientSecret": "vetolib-api-dev-secret"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:6100",
      "http://localhost:6200"
    ]
  },
  "Email": {
    "Provider": "smtp",
    "Smtp": {
      "Host": "localhost",
      "Port": 1025,
      "EnableSsl": false,
      "FromAddress": "noreply@vetara.ae",
      "FromName": "Vetara"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Warning"
      }
    }
  }
}
